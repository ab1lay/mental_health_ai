OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
MODEL=gpt-6.1-sol
# Reasoning effort for reasoning models: low | medium | high (ignored for gpt-4o-style models)
REASONING_EFFORT=low
LOG_LEVEL=INFO

# Webhook mode (leave USE_WEBHOOK=False for polling)
USE_WEBHOOK=False
WEBHOOK_HOST=
WEBHOOK_PORT=8443
WEBHOOK_PATH=

# Proactive check-ins
PROACTIVE_ENABLED=True
PROACTIVE_CHECK_INTERVAL_MINUTES=30
PROACTIVE_IDLE_HOURS=24
PROACTIVE_MIN_USER_MESSAGES=2
PROACTIVE_BATCH_SIZE=20

# Patient web portal
PATIENT_PORTAL_BASE_URL=http://127.0.0.1:8000
PATIENT_PORTAL_TOKEN_TTL_MINUTES=30

# Emergency number shown in crisis prompts
CRISIS_PHONE=112
